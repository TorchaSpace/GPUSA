__pycache__/
*.pyc
.venv/
venv/

# Runtime data - never commit the live shared backend or its WAL files.
# Note: in normal installed use, shared_backend.db actually lives under
# %ProgramData% (see shared/paths.py), not in the repo - these patterns
# guard the dev-mode/test fallback case.
shared_backend.db
shared_backend.db-wal
shared_backend.db-shm

.pytest_cache/

# PyInstaller / Inno Setup build output - regenerated by build_exe.bat
# and the .iss scripts, never hand-edited, never committed.
pos_app/build/
pos_app/dist/
pos_app/installer_output/
admin_app/build/
admin_app/dist/
admin_app/installer_output/
depot_app/build/
depot_app/dist/
depot_app/installer_output/

# deploy_system.py's flat mass-deployment output and scratch build dir -
# regenerated every run (config.json included, since it's user-input-
# derived, not hand-authored), never committed.
/dist/
_deploy_build/

# build_setup.py's two-stage installer output and scratch build dir -
# Kurulum/setup.exe is regenerated by build_setup.py, never hand-edited,
# never committed (it embeds the payload apps, which are themselves build
# output).
_setup_build/
Kurulum/

# build.exe - make_build_exe.bat's compiled convenience wrapper around
# build_setup.py. Regenerated on demand, never hand-edited, never
# committed (and quickly goes stale against build_setup.py if it were).
/build.exe
_build_tool_build/

# macOS / scratch
.DS_Store
Claude outputs/

# packaging/build_release.py output
/release/
/build_release/
