# Copy to server/.env for LOCAL development only. .env is git-ignored -
# never commit real values. On AWS these come from the EC2 env file instead.

# Local dev: one connection string, nothing else needed.
DATABASE_URL=postgresql://gpusa:gpusa@localhost:5432/gpusa

# AWS (leave DATABASE_URL unset there). The password is never in an env var:
# it is read at runtime from the Secrets Manager secret below.
# GPUSA_DB_HOST=gpusa-db.xxxx.eu-central-1.rds.amazonaws.com
# GPUSA_DB_PORT=5432
# GPUSA_DB_NAME=gpusa
# GPUSA_DB_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:123456789012:secret:rds!db-...
# GPUSA_DB_SSLMODE=require
